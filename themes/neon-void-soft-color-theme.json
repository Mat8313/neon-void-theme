  // ==========================================================================
  // COLORATION SYNTAXIQUE (TextMate)
  // Rappel : le style le plus SPÉCIFIQUE gagne, et fontStyle s'hérite du
  // parent. D'où les "fontStyle": "" explicites pour annuler un gras/italique.
  // ==========================================================================
  "tokenColors": [
    // ---------------------------------------------------------------- Base
    {
      "name": "Texte par défaut",
      "scope": ["source", "text"],
      "settings": { "foreground": "#D9D9E3" }
    },

    // ---------------------------------------------------------- Commentaires
    {
      "name": "Commentaires (bleu-gris, italique)",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "string.comment"
      ],
      "settings": { "foreground": "#7684A5", "fontStyle": "italic" }
    },
    {
      "name": "Tags de documentation (@param, /// [ref], PHPDoc)",
      "scope": [
        "comment keyword.other.phpdoc",
        "comment storage.type.class.jsdoc",
        "comment.block.documentation storage.type",
        "comment.block.documentation keyword",
        "comment.block.documentation variable",
        "comment variable.other.dart"
      ],
      "settings": { "foreground": "#B48CF2", "fontStyle": "italic" }
    },

    // ------------------------------------------------------------ Mots-clés
    {
      "name": "Mots-clés et contrôle de flux (rose néon, gras)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeid",
        "keyword.operator.cast",
        "keyword.operator.wordlike",
        "keyword.operator.logical.sql",
        "storage.type",
        "storage.modifier",
        "support.function.construct.php",
        "punctuation.section.embedded.begin.php",
        "punctuation.section.embedded.end.php"
      ],
      "settings": { "foreground": "#F2709C", "fontStyle": "bold" }
    },
    {
      "name": "this / self / super / $this (rose, italique, sans gras)",
      "scope": ["variable.language", "variable.language.this", "variable.language.super"],
      "settings": { "foreground": "#F2709C", "fontStyle": "italic" }
    },

    // ------------------------------------------ Opérateurs et ponctuation
    {
      "name": "Opérateurs (discrets)",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.ternary",
        "punctuation.separator.namespace.access",
        "punctuation.separator.scope-resolution"
      ],
      "settings": { "foreground": "#8A93B0", "fontStyle": "" }
    },
    {
      "name": "Pointeurs et références C/C++ (* & ->) : rose, non gras, car porteurs de sens",
      "scope": [
        "storage.modifier.pointer",
        "storage.modifier.reference",
        "keyword.operator.dereference",
        "keyword.operator.address",
        "punctuation.separator.pointer-access",
        "keyword.operator.arrow"
      ],
      "settings": { "foreground": "#F2709C", "fontStyle": "" }
    },
    {
      "name": "Ponctuation (très discrète)",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.tag",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments"
      ],
      "settings": { "foreground": "#7C86A2" }
    },

    // ------------------------------------------------------------- Chaînes
    {
      "name": "Chaînes (vert néon)",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.unquoted",
        "punctuation.definition.string",
        "string.quoted.other.lt-gt.include",
        "meta.preprocessor.include string"
      ],
      "settings": { "foreground": "#72E3A0" }
    },
    {
      "name": "Interpolation dans les chaînes (Dart ${}, JS ${}, PHP {$})",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.string.interpolation",
        "string.interpolated.expression.dart punctuation"
      ],
      "settings": { "foreground": "#F2709C", "fontStyle": "" }
    },
    {
      "name": "Variables interpolées",
      "scope": [
        "meta.template.expression",
        "string.interpolated.expression",
        "string variable.other.dart",
        "string variable.other.php"
      ],
      "settings": { "foreground": "#D9D9E3" }
    },
    {
      "name": "Séquences d'échappement et regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"],
      "settings": { "foreground": "#F2A765" }
    },

    // ------------------------------------------ Nombres et constantes
    {
      "name": "Nombres, constantes, booléens, null (orange néon)",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "constant.character",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant",
        "keyword.other.unit",
        "constant.character.entity",
        "constant.other.color"
      ],
      "settings": { "foreground": "#F2A765", "fontStyle": "" }
    },

    // ----------------------------------------------- Fonctions et méthodes
    {
      "name": "Fonctions et méthodes (cyan)",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function",
        "entity.name.operator.custom-literal",
        "support.function.aggregate.sql",
        "support.function.scalar.sql"
      ],
      "settings": { "foreground": "#5CDCEB", "fontStyle": "" }
    },

    // ------------------------------------------------- Types et classes
    {
      "name": "Types, classes, structs, enums, widgets Flutter (jaune)",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "storage.type.built-in",
        "storage.type.primitive",
        "storage.type.primitive.dart",
        "storage.type.sql",
        "support.type.primitive",
        "support.class.dart",
        "support.class.php",
        "constant.other.table-name.sql"
      ],
      "settings": { "foreground": "#EBD973", "fontStyle": "" }
    },
    {
      "name": "Paramètres de template C++ / génériques (jaune, italique)",
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.template",
        "storage.type.template.argument",
        "meta.template.expression storage.type"
      ],
      "settings": { "foreground": "#EBD973", "fontStyle": "italic" }
    },
    {
      "name": "Namespaces, packages (jaune, italique)",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.name.type.namespace",
        "support.other.namespace.php",
        "entity.name.package",
        "constant.other.database-name.sql"
      ],
      "settings": { "foreground": "#EBD973", "fontStyle": "italic" }
    },

    // -------------------------------------- Variables, paramètres, propriétés
    {
      "name": "Variables (blanc cassé)",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.php",
        "punctuation.definition.variable.php",
        "meta.definition.variable.name",
        "support.variable"
      ],
      "settings": { "foreground": "#D9D9E3" }
    },
    {
      "name": "Paramètres de fonction (blanc cassé, italique)",
      "scope": ["variable.parameter", "meta.parameter variable"],
      "settings": { "foreground": "#D9D9E3", "fontStyle": "italic" }
    },
    {
      "name": "Propriétés, membres, champs (violet)",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property",
        "entity.name.variable.field",
        "meta.property.object"
      ],
      "settings": { "foreground": "#B48CF2", "fontStyle": "" }
    },

    // ------------------------------------ Préprocesseur C / C++
    {
      "name": "Directives #include #define #ifdef (rose, gras)",
      "scope": [
        "keyword.control.directive",
        "punctuation.definition.directive",
        "meta.preprocessor keyword.control",
        "keyword.other.preprocessor"
      ],
      "settings": { "foreground": "#F2709C", "fontStyle": "bold" }
    },
    {
      "name": "Noms de macros (orange, comme les constantes)",
      "scope": [
        "entity.name.function.preprocessor",
        "entity.name.other.preprocessor.macro",
        "meta.preprocessor.macro entity.name.function",
        "variable.other.macro"
      ],
      "settings": { "foreground": "#F2A765", "fontStyle": "" }
    },

    // ------------------------------------ Annotations / décorateurs
    {
      "name": "Annotations Dart (@override, @required), décorateurs, attributs PHP (violet, italique)",
      "scope": [
        "storage.type.annotation",
        "storage.type.annotation.dart",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute.php"
      ],
      "settings": { "foreground": "#B48CF2", "fontStyle": "italic" }
