    },
    {
      "name": "Java : champs d'objet (this.name)",
      "scope": ["variable.other.object.property.java", "variable.other.definition.java"],
      "settings": { "foreground": "#B48CF2", "fontStyle": "" }
    },

    // -------------------------------------------------------------- Python
    {
      "name": "Python : self / cls (rose, italique, comme this)",
      "scope": [
        "variable.language.special.self.python",
        "variable.parameter.function.language.special.self.python",
        "variable.language.special.cls.python",
        "variable.parameter.function.language.special.cls.python"
      ],
      "settings": { "foreground": "#F2709C", "fontStyle": "italic" }
    },
    {
      "name": "Python : décorateurs @property, @dataclass (violet, italique)",
      "scope": [
        "entity.name.function.decorator.python",
        "punctuation.definition.decorator.python",
        "meta.function.decorator.python support.type"
      ],
      "settings": { "foreground": "#B48CF2", "fontStyle": "italic" }
    },
    {
      "name": "Python : docstrings (traitées comme de la documentation)",
      "scope": ["string.quoted.docstring", "string.quoted.docstring punctuation.definition.string"],
      "settings": { "foreground": "#7684A5", "fontStyle": "italic" }
    },
    {
      "name": "Python : préfixe f\"\" et accolades des f-strings (rose, non gras)",
      "scope": [
        "storage.type.string.python",
        "storage.type.format.python",
        "constant.character.format.placeholder.other.python"
      ],
      "settings": { "foreground": "#F2709C", "fontStyle": "" }
    },
    {
      "name": "Python : fonctions natives (print, len, range) et appels",
      "scope": ["support.function.builtin.python", "meta.function-call.generic.python"],
      "settings": { "foreground": "#5CDCEB", "fontStyle": "" }
    },
    {
      "name": "Python : types natifs (int, str, list) et exceptions",
      "scope": ["support.type.python", "support.type.exception.python"],
      "settings": { "foreground": "#EBD973", "fontStyle": "" }
    },
    {
      "name": "Python : noms de modules importés (jaune, italique)",
      "scope": ["entity.name.namespace.python", "meta.import.python entity.name"],
      "settings": { "foreground": "#EBD973", "fontStyle": "italic" }
    },

    // ----------------------------------------------------------------- PHP
    {
      "name": "PHP : types des signatures (int, string, ?array) — jaune, pas rose",
      "scope": ["keyword.other.type.php"],
      "settings": { "foreground": "#EBD973", "fontStyle": "" }
    },

    // ------------------------------------------------------------- Erreurs
    {
      "name": "Code invalide",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#F07085", "fontStyle": "underline" }
    },
    {
      "name": "Code déprécié",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#F2A765", "fontStyle": "strikethrough" }
    }
  ],

  // ==========================================================================
  // COULEURS SÉMANTIQUES (fournies par les serveurs de langage)
  // Elles priment sur TextMate quand le serveur les envoie : même logique
  // de couleurs pour que les deux systèmes restent cohérents.
  // ==========================================================================
  "semanticTokenColors": {
    "keyword": { "foreground": "#F2709C", "bold": true },
    "comment": { "foreground": "#7684A5", "italic": true },
    "string": "#72E3A0",
    "number": "#F2A765",
    "regexp": "#F2A765",
    "operator": "#8A93B0",

    "function": "#5CDCEB",
    "method": "#5CDCEB",
    "function.defaultLibrary": "#5CDCEB",
    "method.static": { "foreground": "#5CDCEB", "italic": true },

    "type": "#EBD973",
    "class": "#EBD973",
    "struct": "#EBD973",
    "interface": { "foreground": "#EBD973", "italic": true },
    "enum": "#EBD973",
    "typeParameter": { "foreground": "#EBD973", "italic": true },
    "namespace": { "foreground": "#EBD973", "italic": true },
    // Types spécifiques à l'extension C/C++ de Microsoft (cpptools)
    "templateType": { "foreground": "#EBD973", "italic": true },
    "templateFunction": "#5CDCEB",

    "enumMember": "#F2A765",
    "macro": "#F2A765",
    "variable.readonly": "#F2A765",
    "variable.constant": "#F2A765",
    "property.static": { "foreground": "#F2A765" },

    "variable": "#D9D9E3",
    "parameter": { "foreground": "#D9D9E3", "italic": true },
    "property": "#B48CF2",
    "property.readonly": "#B48CF2",

    // Dart : annotations (@override) et accesseurs
    "annotation": { "foreground": "#B48CF2", "italic": true },
    "decorator": { "foreground": "#B48CF2", "italic": true },

    // Java (extension Red Hat) : membres d'annotation et modificateurs
    "annotationMember": "#B48CF2",
    "modifier": { "foreground": "#F2709C", "bold": true },

    // Python (Pylance) : self/cls comme "this", modules comme namespaces
    "selfParameter": { "foreground": "#F2709C", "italic": true },
    "clsParameter": { "foreground": "#F2709C", "italic": true },
    "module": { "foreground": "#EBD973", "italic": true },
    "builtinConstant": "#F2A765",

    // Tout symbole déprécié est barré
    "*.deprecated": { "strikethrough": true }
  }
}
